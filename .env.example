# Скопируйте в .env и поменяйте значения перед развёртыванием
SECRET_KEY=change-me-in-production
COOKIE_SECURE=false          # true, если сайт работает по HTTPS
HTTP_PORT=8080
SEED_DEMO_DATA=1             # 0 — не заполнять базу демо-данными

POSTGRES_USER=rt
POSTGRES_PASSWORD=rt
POSTGRES_DB=rt
RABBITMQ_USER=rt
RABBITMQ_PASSWORD=rt
GRAFANA_PASSWORD=admin

# Трассировка API выключена по умолчанию. Для включения задайте OTEL_TRACES_EXPORTER=otlp
# и OTEL_EXPORTER_OTLP_ENDPOINT на доступный из контейнера OpenTelemetry Collector.
OTEL_TRACES_EXPORTER=none
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_SERVICE_NAME=rt-analytics-api
OTEL_TRACES_SAMPLER_ARG=1.0
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
